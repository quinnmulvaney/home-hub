rules_version = '2';
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's pointer to the household they belong to.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{hid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }

      allow read: if isMember();

      // Creating a household: you must be its only member.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // Members can edit (e.g. rename). Non-members holding the invite code
      // may only add themselves to `members` and change nothing else.
      allow update: if isMember() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
      );

      // Budget, calendar, shopping lists, ... — members only.
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }
  }
}
